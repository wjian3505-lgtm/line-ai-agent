# ===== LINE Messaging API =====
# LINE Developers Console > Messaging API 頻道取得
LINE_CHANNEL_ACCESS_TOKEN=你的_channel_access_token
LINE_CHANNEL_SECRET=你的_channel_secret

# ===== Google Gemini =====
# https://aistudio.google.com/app/apikey 取得
GEMINI_API_KEY=你的_gemini_api_key
# 可選，預設 gemini-3.5-flash（技術面判定沿用此模型，不必另設金鑰）
GEMINI_MODEL=gemini-3.5-flash

# ===== Fugle 富果行情 =====
# https://developer.fugle.tw 申請
FUGLE_API_KEY=你的_fugle_api_key
# 每日收盤整理要追蹤的自選股（逗號分隔），例如台積電、聯發科、鴻海
STOCK_WATCHLIST=2330,2454,2317

# ===== 資料庫 =====
# 本地開發不填會自動用 SQLite；Zeabur 上請填 PostgreSQL 連線字串
# 範例：postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=

# ===== 每日推播（可選）=====
# 要接收每日收盤整理的 LINE user id（用 /tasks/daily-summary 觸發時使用）
DAILY_PUSH_USER_ID=
TASK_SECRET=

# ===== Google Calendar =====
# Google Cloud Console > API 與服務 > 憑證 > OAuth 用戶端 ID（網頁應用程式）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 主要行事曆填 primary；或填特定 calendar id
GOOGLE_CALENDAR_ID=primary
# 本機授權建議用 localhost（較穩定）；並把同一網址加到 OAuth「已授權的重新導向 URI」
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback
PUBLIC_BASE_URL=http://localhost:8080
